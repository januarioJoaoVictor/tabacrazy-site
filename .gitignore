# Dependências (não usamos build, mas evita commitar se alguém rodar npm)
node_modules/
package-lock.json

# Logs
*.log
npm-debug.log*

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDEs
.vscode/
.idea/
*.swp

# Artefatos temporários de teste (puppeteer, screenshots ad-hoc)
_*.cjs
_*.png
_*.html

# Fotos-fonte dos produtos (JPGs originais ~4MB cada, ~780MB).
# O site usa as versões otimizadas em assets/produtos/*.webp (essas SIM são versionadas).
# Barra inicial = ancora na raiz, pra NÃO ignorar assets/produtos/.
/produtos/
/produtos_selecionadas/

# Config/instruções internas — não publicar no site nem no repo
.claude/
CLAUDE.md
AGENTS.md
# Listagem gerada de assets (artefato de script, não faz parte do site)
refs.txt
# (README.md é mantido versionado — doc padrão do repositório)

# Mídias de marketing geradas (fotos/vídeos ~80MB) — uso interno, não publicar no site
marketing/

# Planilhas internas (tabela de preços etc.) — não publicar
*.xlsx
